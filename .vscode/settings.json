{
  "latex-workshop.latex.tools": [
    {
      "name": "latexdiff",
      "command": "cmd",
      "args": ["/c", "latexdiff main_v20260310.tex main.tex > main-diff.tex"]
    },
    {
      "name": "pdflatex (diff)",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=build",
        "main-diff"
      ]
    },
    {
      "name": "bibtex (diff)",
      "command": "bibtex",
      "args": ["build/main-diff"]
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": [
        "%OUTDIR%/%DOCFILE%"
      ]
    },
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "QuickPass (Save)",
      "tools": ["lualatex"]
    },
    {
      "name": "FullBuild",
      "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
    },
    {
      "name": "latexmk (aux in build, pdf in root)",
      "tools": ["latexmk (aux in build, pdf in root)"]
    },
    {
      "name": "Diff Build (wrt v20260310)",
      "tools": ["latexdiff", "pdflatex (diff)", "bibtex (diff)", "pdflatex (diff)", "pdflatex (diff)"]
    },
    {
      "name": "Diff (wrt v20260310)",
      "tools": ["latexdiff"]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.recipe.default": "FullBuild", // "latexmk (aux in build, pdf in root)",
}
